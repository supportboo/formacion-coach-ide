# SkillUp platform — Fase 0
# Copia a .env.local y rellena. NUNCA subir .env.local a git.

# Postgres (local escuchando en :5432 según recon). Ajusta usuario/clave/DB.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/skillup

# LLM (agentes). Sin clave -> se usa el LLM mock (dev/tests).
ANTHROPIC_API_KEY=

# Embeddings del RAG. provider: dev | openai
#  dev    = embedding determinista offline (para tests/dev, sin coste ni clave)
#  openai = text-embedding-3-small (requiere OPENAI_API_KEY)
EMBEDDINGS_PROVIDER=dev
OPENAI_API_KEY=

# Auth
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo
BETTER_AUTH_URL=http://localhost:8080

# Server
PORT=8080
# Modo dev-auth: acepta cabeceras X-Org-Id/X-User-Id/X-Role sin sesión real.
# SOLO para desarrollo local. En producción = false (sesión better-auth).
DEV_AUTH=true
