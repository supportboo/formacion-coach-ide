keColor": "#4263eb", "backgroundColor": "transparent", "width": 30, "height": 0, "seed": 1384904737, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0], [30, 0]], "lastCommittedPoint": null, "startBinding": {"elementId": "v11no6uck5po", "focus": 0, "gap": 6}, "endBinding": {"elementId": "339x9se5dv2f", "focus": 0, "gap": 6}, "startArrowhead": null, "endArrowhead": "arrow"}, {"type": "rectangle", "version": 1, "versionNonce": 734272080, "isDeleted": false, "id": "x1qx6qcemjx3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "x": 140, "y": 577, "strokeColor": "#2f9e44", "backgroundColor": "#ebfbee", "width": 740, "height": 360, "seed": 675428775, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"type": "text", "version": 1, "versionNonce": 1784177078, "isDeleted": false, "id": "g1zsiwcbtiwl", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "x": 156, "y": 591, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "width": 708, "height": 26, "seed": 735805415, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 16, "fontFamily": 2, "text": "CONSTRUIDO Y VERIFICADO \u00b7 platform/ (Fases 0-7)", "textAlign": "left", "verticalAlign": "middle", "containerId": null, "originalText": "CONSTRUIDO Y VERIFICADO \u00b7 platform/ (Fases 0-7)", "lineHeight": 1.25, "baseline": 13}, {"type": "text", "version": 1, "versionNonce": 1527782823, "isDeleted": false, "id": "4u84zlikj7qa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "x": 156, "y": 625, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "width": 708, "height": 300, "seed": 447936275, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 12.5, "fontFamily": 2, "text": "\u2022 Multi-tenant: Postgres + Drizzle (26 tablas), aislamiento por empresa\n\u2022 Auth + organizaci\u00f3n (better-auth): 1 usuario a multinacional\n\u2022 RAG: embeddings + ingesta + recuperaci\u00f3n por significado\n\u2022 Agentes conversacionales por rol (LLM Anthropic; mock sin clave)\n\u2022 Aprendizaje: onboarding, matr\u00edcula, test -> Nivel 1\n\u2022 Validaci\u00f3n humana con r\u00fabrica -> Nivel 2 (no autoservicio)\n\u2022 Propagaci\u00f3n: coaching, puntos al aprobar, ascenso a Referente, antifraude\n\u2022 Config + motor de reglas + certificados verificables (no salarial)\n\u2022 Panel ROI: cobertura, riesgo de dependencia, transferencia interna\n\u2022 FUNDAE: acci\u00f3n bonificable, control 75%, export justificativo\n\nVerificado: typecheck 0 \u00b7 8 tests unit \u00b7 8 tests integraci\u00f3n vs Postgres", "textAlign": "left", "verticalAlign": "middle", "containerId": null, "originalText": "\u2022 Multi-tenant: Postgres + Drizzle (26 tablas), aislamiento por empresa\n\u2022 Auth + organizaci\u00f3n (better-auth): 1 usuario a multinacional\n\u2022 RAG: embeddings + ingesta + recuperaci\u00f3n por significado\n\u2022 Agentes conversacionales por rol (LLM Anthropic; mock sin clave)\n\u2022 Aprendizaje: onboarding, matr\u00edcula, test -> Nivel 1\n\u2022 Validaci\u00f3n humana con r\u00fabrica -> Nivel 2 (no autoservicio)\n\u2022 Propagaci\u00f3n: coaching, puntos al aprobar, ascenso a Referente, antifraude\n\u2022 Config + motor de reglas + certificados verificables (no salarial)\n\u2022 Panel ROI: cobertura, riesgo de dependencia, transferencia interna\n\u2022 FUNDAE: acci\u00f3n bonificable, control 75%, export justificativo\n\nVerificado: typecheck 0 \u00b7 8 tests unit \u00b7 8 tests integraci\u00f3n vs Postgres", "lineHeight": 1.25, "baseline": 10}, {"type": "rectangle", "version": 1, "versionNonce": 1517169444, "isDeleted": false, "id": "typ1y67h74kx", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "x": 910, "y": 577, "strokeColor": "#e03131", "backgroundColor": "#fff5f5", "width": 740, "height": 360, "seed": 317758884, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"type": "text", "version": 1, "versionNonce": 1351982177, "isDeleted": false, "id": "2jsa4ccn1zdu", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "x": 926, "y": 591, "strokeColor": "#e03131", "backgroundColor": "transparent", "width": 708, "height": 26, "seed": 1422958288, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 16, "fontFamily": 2, "text": "PENDIENTE / DIFERIDO", "textAlign": "left", "verticalAlign": "middle", "containerId": null, "originalText": "PENDIENTE / DIFERIDO", "lineHeight": 1.25, "baseline": 13}, {"type": "text", "version": 1, "versionNonce": 1692493024, "isDeleted": false, "id": "msjiiv89xo11", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "x": 926, "y": 625, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "width": 708, "height": 300, "seed": 1758140757, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 12.5, "fontFamily": 2, "text": "Config (no c\u00f3digo):\n\u2022 Clave Anthropic para respuestas reales de los agentes (ahora mock)\n\u2022 Postgres en el VPS para desplegar (ahora corre en Postgres local)\n\nAmarillo (parcial):\n\u2022 Generaci\u00f3n IA de la ruta/lecciones enganchada al onboarding\n\u2022 L\u00ednea base del piloto + gate de coste de IA por alumno\n\u2022 Tiempo hasta autonom\u00eda + tracking de la garant\u00eda\n\nDiferido:\n\u2022 Cobro por plan / pagos (Fase 8, hasta que el producto se venda)\n\u2022 Doble revisi\u00f3n N3 + auditor\u00eda por muestreo de la cascada\n\u2022 Conectar los HTML actuales de SkillUp a la nueva API", "textAlign": "left", "verticalAlign": "middle", "containerId": null, "originalText": "Config (no c\u00f3digo):\n\u2022 Clave Anthropic para respuestas reales de los agentes (ahora mock)\n\u2022 Postgres en el VPS para desplegar (ahora corre en Postgres local)\n\nAmarillo (parcial):\n\u2022 Generaci\u00f3n IA de la ruta/lecciones enganchada al onboarding\n\u2022 L\u00ednea base del piloto + gate de coste de IA por alumno\n\u2022 Tiempo hasta autonom\u00eda + tracking de la garant\u00eda\n\nDiferido:\n\u2022 Cobro por plan / pagos (Fase 8, hasta que el producto se venda)\n\u2022 Doble revisi\u00f3n N3 + auditor\u00eda por muestreo de la cascada\n\u2022 Conectar los HTML actuales de SkillUp a la nueva API", "lineHeight": 1.25, "baseline": 10}, {"type": "rectangle", "version": 1, "versionNonce": 516933582, "isDeleted": false, "id": "bfdmuvqv6qft", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "x": 1680, "y": 577, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "width": 740, "height": 360, "seed": 186813338, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"type": "text", "version": 1, "versionNonce": 256705005, "isDeleted": false, "id": "syonihi6fr92", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "x": 1696, "y": 591, "strokeColor": "#1971c2", "backgroundColor": "transparent", "width": 708, "height": 26, "seed": 1881002577, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 17, "fontFamily": 2, "text": "ESTRATEGIA DE ADOPCI\u00d3N \u2192 ROI", "textAlign": "left", "verticalAlign": "middle", "containerId": null, "originalText": "ESTRATEGIA DE ADOPCI\u00d3N \u2192 ROI", "lineHeight": 1.25, "baseline": 14}, {"type": "text", "version": 1, "versionNonce": 1465698798, "isDeleted": false, "id": "to0vxjknvoze", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "x": 1696, "y": 627, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "width": 708, "height": 240, "seed": 917828637, "groupIds": [], "frameId": null, "roundness": null, "boundElements": [], "updated": 1, "link": null, "locked": false, "fontSize": 13, "fontFamily": 2, "text": "1. Entra por un equipo, no por toda la plantilla.\n2. Onboarding define por qu\u00e9/para qu\u00e9 -> ruta a su puesto.\n3. Aprende con lo suyo y DEMUESTRA en un caso real.\n4. El responsable valida -> mete al mando en el bucle.\n5. El que domina forma al siguiente -> el saber se queda y se multiplica.\n6. El panel convierte capacidad en ROI: cobertura, riesgo,\n    coste de formar, tiempo a autonom\u00eda.\n7. Garant\u00eda: si no ves la medici\u00f3n, no pagas.\n8. FUNDAE baja el coste; Boomatik se usa a s\u00ed misma = caso 0.\n\nRegla de voz: a la web solo salen RESULTADOS, nunca la mec\u00e1nica.", "textAlign": "left", "verticalAlign": "middle", "containerId": null, "originalText": "1. Entra por un equipo, no por toda la plantilla.\n2. Onboarding define por qu\u00e9/para qu\u00e9 -> ruta a su puesto.\n3. Aprende con lo suyo y DEMUESTRA en un caso real.\n4. El responsable valida -> mete al mando en el bucle.\n5. El que domina forma al siguiente -> el saber se queda y se multiplica.\n6. El panel convierte capacidad en ROI: cobertura, riesgo,\n    coste de formar, tiempo a autonom\u00eda.\n7. Garant\u00eda: si no ves la medici\u00f3n, no pagas.\n8. FUNDAE baja el coste; Boomatik se usa a s\u00ed misma = caso 0.\n\nRegla de voz: a la web solo salen RESULTADOS, nunca la mec\u00e1nica.", "lineHeight": 1.25, "baseline": 11}], "appState": {"gridSize": null, "viewBackgroundColor": "#fbfbfd"}, "files": {}}